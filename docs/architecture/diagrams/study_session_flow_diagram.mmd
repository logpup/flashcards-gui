sequenceDiagram
    participant User
    participant UI as Study View
    participant VM as Study ViewModel
    participant StudySvc as Study Service
    participant Mode as Study Mode<br/>(Flashcard/Quiz)
    participant Scheduler
    participant CardRepo as Card Repository
    participant DB as Database
    
    User->>UI: Click "Start Study"
    UI->>VM: start_study(deck_id)
    VM->>StudySvc: create_session(deck_id, mode_type)
    
    StudySvc->>CardRepo: get_due_cards(deck_id)
    CardRepo->>DB: SELECT * FROM cards WHERE...
    DB-->>CardRepo: cards[]
    CardRepo-->>StudySvc: cards[]
    
    StudySvc->>Mode: initialize(cards)
    Mode-->>StudySvc: session
    StudySvc-->>VM: session_id
    VM-->>UI: show_first_card()
    
    loop For each card
        UI->>User: Display card front
        User->>UI: Flip card / Submit answer
        UI->>VM: submit_response(response)
        VM->>StudySvc: process_response(session_id, response)
        
        StudySvc->>Mode: process_response(card, response)
        Mode->>Mode: validate_answer()
        Mode-->>StudySvc: result{correct, score}
        
        alt Flashcard Mode
            StudySvc->>Scheduler: calculate_next_review(card, rating)
            Scheduler-->>StudySvc: next_review_date
        else Quiz Mode
            StudySvc->>StudySvc: accumulate_score()
        end
        
        StudySvc->>CardRepo: update_review(card_id, result)
        CardRepo->>DB: UPDATE cards SET...
        
        StudySvc->>Mode: get_next_item()
        Mode-->>StudySvc: next_card
        StudySvc-->>VM: next_card
        VM-->>UI: display_next_card()
    end
    
    StudySvc->>StudySvc: generate_statistics()
    StudySvc-->>VM: session_results
    VM-->>UI: show_results_screen()
    UI->>User: Display statistics